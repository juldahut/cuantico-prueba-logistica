# Copia este archivo a .env (en la raiz) antes de "docker compose up". NUNCA versiones .env.
POSTGRES_USER=cuantico
# Usa una clave simple (sin caracteres especiales: va dentro de una URL).
POSTGRES_PASSWORD=
POSTGRES_DB=cuantico

# Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Clave de los usuarios de ejemplo (seeds). Minimo 12 caracteres. Ver README.
DEMO_USERS_PASSWORD=

# Agente: "fake" (modelo simulado, sin llave) o "anthropic" (requiere ANTHROPIC_API_KEY).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
