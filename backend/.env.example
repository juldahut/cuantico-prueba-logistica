# Copia a backend/.env SOLO si corres el backend fuera de Docker. Nunca versiones .env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://cuantico:CAMBIA_ESTA_CLAVE@localhost:5432/cuantico
TEST_DATABASE_URL=postgres://cuantico:CAMBIA_ESTA_CLAVE@localhost:5432/cuantico_test

# Minimo 32 caracteres. Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Claves de los usuarios de ejemplo (seeds): una distinta por usuario, de 12 caracteres a 72 bytes.
DEMO_ADMIN_PASSWORD=
DEMO_OPS_LA80_PASSWORD=
DEMO_OPS_FARMACIA_PASSWORD=
DEMO_INGEST_PASSWORD=
JWT_EXPIRES_IN=2h

CORS_ORIGIN=http://localhost:5173

# Agente: "fake" (modelo simulado, sin llave), "anthropic" (requiere ANTHROPIC_API_KEY) o "gemini" (requiere GEMINI_API_KEY).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
# Opcional; por defecto gemini-2.5-flash.
# Probado con gemini-2.5-flash. Los modelos 3.x validan la firma de pensamiento y el servidor
# no les preinyecta list_merchants (el modelo la pide; una llamada mas por pregunta).
GEMINI_MODEL=

# --- Limites y timeouts (todos opcionales; sin valor se usa el default indicado) ---
# Tiempo maximo de espera de una llamada al LLM, en ms (default 30000).
LLM_TIMEOUT_MS=
# Peticiones por minuto: POST /events por cuenta autenticada (default 600) y
# POST /agent/chat por usuario (default 20). IP de respaldo si no hay cuenta.
INGEST_RPM=
AGENT_RPM=
# Peticiones por minuto a las consultas de lectura, por usuario (default 120).
READ_RPM=
# Plazo total de una pregunta al agente, en ms (default 60000).
AGENT_DEADLINE_MS=
# Saltos de proxy confiables (balanceador, nginx). Sin definir: no se confia en
# X-Forwarded-For. Pon el numero exacto de proxies delante de la API (p. ej. 1).
TRUST_PROXY=
# Conexiones maximas al pool de PostgreSQL (default 10).
DB_POOL_MAX=
# Timeouts de sesion de PostgreSQL en ms (defaults 15000 / 5000 / 15000): consulta,
# espera de locks y transaccion abierta sin actividad.
DB_STATEMENT_TIMEOUT_MS=
DB_LOCK_TIMEOUT_MS=
DB_IDLE_IN_TX_TIMEOUT_MS=

# Solo para contenedores: "true" siembra datos y usuarios de demo al arrancar (usa las
# claves DEMO_* de arriba). Cualquier otro valor no siembra. Fuera de Docker se siembra a
# mano con "npx sequelize-cli db:seed:all".
SEED_DEMO=
