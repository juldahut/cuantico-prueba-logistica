# Copia a backend/.env SOLO si corres el backend fuera de Docker. Nunca versiones .env.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://cuantico:CAMBIA_ESTA_CLAVE@localhost:5432/cuantico
TEST_DATABASE_URL=postgres://cuantico:CAMBIA_ESTA_CLAVE@localhost:5432/cuantico_test

# Genera uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Clave de los usuarios de ejemplo (seeds). Minimo 12 caracteres. Ver README.
DEMO_USERS_PASSWORD=
JWT_EXPIRES_IN=2h

CORS_ORIGIN=http://localhost:5173

# Agente: "fake" (modelo simulado, sin llave) o "anthropic" (requiere ANTHROPIC_API_KEY).
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
